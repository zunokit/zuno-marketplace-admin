/**
 * useMembers Hook
 * React Query hooks for member and invitation management with optimized caching
 */

import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query'
import { queryKeys, staleTimeConfig, gcTimeConfig } from '../config'
import {
  getMembersAction,
  getInvitationsAction,
  inviteMemberAction,
  removeMemberAction,
  updateMemberRoleAction,
  revokeInvitationAction,
} from '@/app/actions/members/member-actions'
import { toast } from 'sonner'

/**
 * Fetch members for a project with caching
 */
export function useProjectMembers(projectId: string | null) {
  return useQuery({
    queryKey: queryKeys.members.list(projectId || ''),
    queryFn: async () => {
      if (!projectId) throw new Error('Project ID is required')
      const result = await getMembersAction(projectId)
      if (result.success && result.data) {
        return result.data
      }
      throw new Error('error' in result ? result.error : 'Failed to fetch members')
    },
    enabled: !!projectId,
    staleTime: staleTimeConfig.frequent, // 2 minutes - membership changes occasionally
    gcTime: gcTimeConfig.normal, // 10 minutes
  })
}

/**
 * Fetch invitations for a project with caching
 */
export function useProjectInvitations(projectId: string | null) {
  return useQuery({
    queryKey: queryKeys.invitations.list(projectId || ''),
    queryFn: async () => {
      if (!projectId) throw new Error('Project ID is required')
      const result = await getInvitationsAction(projectId)
      if (result.success && result.data) {
        return result.data
      }
      throw new Error('error' in result ? result.error : 'Failed to fetch invitations')
    },
    enabled: !!projectId,
    staleTime: staleTimeConfig.frequent, // 2 minutes
    gcTime: gcTimeConfig.normal, // 10 minutes
  })
}

/**
 * Invite member mutation with cache invalidation
 */
export function useInviteMember() {
  const queryClient = useQueryClient()

  return useMutation({
    mutationFn: async (data: { projectId: string; email: string; role: string }) => {
      const result = await inviteMemberAction(data.projectId, data.email, data.role)
      if (result.success) {
        return data
      }
      throw new Error('error' in result ? result.error : 'Failed to invite member')
    },
    onSuccess: (data) => {
      // Invalidate invitations list to show new invitation
      queryClient.invalidateQueries({ queryKey: queryKeys.invitations.list(data.projectId) })
      toast.success('Invitation sent successfully')
    },
    onError: (error: Error) => {
      toast.error(error.message || 'Failed to invite member')
    },
  })
}

/**
 * Remove member mutation with cache invalidation
 */
export function useRemoveMember() {
  const queryClient = useQueryClient()

  return useMutation({
    mutationFn: async (data: { projectId: string; userId: string }) => {
      const result = await removeMemberAction(data.projectId, data.userId)
      if (result.success) {
        return data
      }
      throw new Error('error' in result ? result.error : 'Failed to remove member')
    },
    onSuccess: (data) => {
      // Invalidate members list
      queryClient.invalidateQueries({ queryKey: queryKeys.members.list(data.projectId) })
      toast.success('Member removed successfully')
    },
    onError: (error: Error) => {
      toast.error(error.message || 'Failed to remove member')
    },
  })
}

/**
 * Update member role mutation with cache invalidation
 */
export function useUpdateMemberRole() {
  const queryClient = useQueryClient()

  return useMutation({
    mutationFn: async (data: { projectId: string; userId: string; role: string }) => {
      const result = await updateMemberRoleAction(data.projectId, data.userId, data.role)
      if (result.success) {
        return data
      }
      throw new Error('error' in result ? result.error : 'Failed to update member role')
    },
    onSuccess: (data) => {
      // Invalidate members list
      queryClient.invalidateQueries({ queryKey: queryKeys.members.list(data.projectId) })
      toast.success('Member role updated successfully')
    },
    onError: (error: Error) => {
      toast.error(error.message || 'Failed to update member role')
    },
  })
}

/**
 * Revoke invitation mutation with cache invalidation
 */
export function useRevokeInvitation() {
  const queryClient = useQueryClient()

  return useMutation({
    mutationFn: async (data: { invitationId: string; projectId: string }) => {
      const result = await revokeInvitationAction(data.invitationId)
      if (result.success) {
        return data
      }
      throw new Error('error' in result ? result.error : 'Failed to revoke invitation')
    },
    onSuccess: (data) => {
      // Invalidate invitations list
      queryClient.invalidateQueries({ queryKey: queryKeys.invitations.list(data.projectId) })
      toast.success('Invitation revoked successfully')
    },
    onError: (error: Error) => {
      toast.error(error.message || 'Failed to revoke invitation')
    },
  })
}

/**
 * Prefetch members and invitations together
 * Useful when navigating to members page
 */
export function usePrefetchMembersPage() {
  const queryClient = useQueryClient()

  return (projectId: string) => {
    // Prefetch both members and invitations
    queryClient.prefetchQuery({
      queryKey: queryKeys.members.list(projectId),
      queryFn: async () => {
        const result = await getMembersAction(projectId)
        if (result.success && result.data) return result.data
        throw new Error('error' in result ? result.error : 'Failed to fetch members')
      },
      staleTime: staleTimeConfig.frequent,
    })

    queryClient.prefetchQuery({
      queryKey: queryKeys.invitations.list(projectId),
      queryFn: async () => {
        const result = await getInvitationsAction(projectId)
        if (result.success && result.data) return result.data
        throw new Error('error' in result ? result.error : 'Failed to fetch invitations')
      },
      staleTime: staleTimeConfig.frequent,
    })
  }
}
