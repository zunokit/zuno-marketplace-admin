# Development Dockerfile for zuno-marketplace-admin (Next.js 16).
# Used by the opt-in `app` service in docker-compose.yml.

FROM node:20-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9 --activate

COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --no-frozen-lockfile

COPY . .

EXPOSE 3000

CMD ["pnpm", "dev"]
