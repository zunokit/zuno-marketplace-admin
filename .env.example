# ========================================
# Admin Dashboard Auth Database (Supabase)
# ========================================
AUTH_DATABASE_URL="postgresql://postgres.xxx:password@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres"

# ========================================
# Better Auth Configuration
# ========================================
BETTER_AUTH_SECRET="your-secret-key-min-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# ========================================
# Supabase Configuration (for Admin Auth)
# ========================================
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ========================================
# Encryption Key (for Database URLs)
# ========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be 64 hexadecimal characters (32 bytes)
ENCRYPTION_KEY="your-64-character-hex-encryption-key-here"

# ========================================
# Application Configuration
# ========================================
NODE_ENV="development"

# ========================================
# IMPORTANT: Project Database Configuration
# ========================================
# Projects are now managed through the admin UI!
# Database URLs are stored encrypted in the admin database.
#
# To add a new project:
# 1. Sign in as super admin
# 2. Go to Projects → Create New Project
# 3. Enter project details and database URL
# 4. Database URL is automatically encrypted and stored
#
# No need to edit .env anymore! 🎉
# ========================================
