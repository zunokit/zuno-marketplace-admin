# ========================================
# Admin Dashboard Auth Database
# ========================================
# Production: Supabase / managed Postgres.
# Local Docker (see docker-compose.yml):
#   postgresql://zuno_user:zuno_pass@localhost:5433/zuno_admin
DATABASE_URL="postgresql://zuno_user:zuno_pass@localhost:5433/zuno_admin"

# ========================================
# Better Auth Configuration
# ========================================
BETTER_AUTH_SECRET="your-secret-key-min-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# ========================================
# Supabase Configuration (for Admin Auth)
# ========================================
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ========================================
# Encryption Key (for Database URLs)
# ========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be 64 hexadecimal characters (32 bytes)
ENCRYPTION_KEY="your-64-character-hex-encryption-key-here"

# ========================================
# Application Configuration
# ========================================
NODE_ENV="development"

# ========================================
# Email Service Configuration
# ========================================

# Email Provider (auto-detects by default)
# Options: 'auto' | 'mailpit' | 'resend'
# - 'auto': Uses Mailpit in development, Resend in production
# - 'mailpit': Force use Mailpit SMTP (for testing)
# - 'resend': Force use Resend API (for production)
EMAIL_PROVIDER="auto"

# Default "from" email address
EMAIL_FROM="noreply@your-domain.com"

# --------------------------------------
# Mailpit Configuration (Development)
# --------------------------------------
# Mailpit is a local SMTP server for testing emails
# Installation: https://mailpit.axllent.org/docs/install/
# Run: mailpit (default port 1025 for SMTP, 8025 for web UI)
# Web UI: http://localhost:8025

SMTP_HOST="localhost"
SMTP_PORT="1025"
# SMTP_USER="" # Optional, leave empty for Mailpit
# SMTP_PASS="" # Optional, leave empty for Mailpit

# --------------------------------------
# Resend Configuration (Production)
# --------------------------------------
# Get your API key from: https://resend.com/api-keys
# Resend is used for production email sending

RESEND_API_KEY="re_your_resend_api_key"

# ========================================
# IMPORTANT: Project Database Configuration
# ========================================
# Projects are now managed through the admin UI!
# Database URLs are stored encrypted in the admin database.
#
# To add a new project:
# 1. Sign in as super admin
# 2. Go to Projects → Create New Project
# 3. Enter project details and database URL
# 4. Database URL is automatically encrypted and stored
#
# No need to edit .env anymore! 🎉
# ========================================
